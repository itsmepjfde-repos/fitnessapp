# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Self-Hosted / Local MySQL 8 Configuration
# Leave MYSQL_HOST empty to run in local preview fallback mode.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=dannysthenics
# Set to true for TiDB Cloud or another MySQL server requiring TLS.
MYSQL_SSL=false

# Optional: Server-side Coach Admin Passcode override
COACH_ADMIN_PASSWORD=

# Generate a random value with at least 16 characters for deployed sessions.
JWT_SECRET=
